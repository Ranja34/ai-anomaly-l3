# Moteur IA : mock (faux modèle, aucun quota), groq ou ollama
LLM_PROVIDER=mock
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=votre_cle_ici
# Protection du quota gratuit
LLM_MAX_APPELS_JOUR=60
LLM_INTERVALLE_MIN_S=5
LLM_MAX_TOKENS=2500
LLM_TENTATIVES=2
LLM_REASONING_EFFORT=low
# Fuseau d'affichage des heures
AIOPS_FUSEAU=Indian/Antananarivo
# Nombre maximum de tentatives de correction par incident
AGENT2_MAX_TENTATIVES=3
# Orchestrateur : intervalle de détection et pause des appels IA après un quota atteint
DETECT_INTERVALLE_S=30
IA_PAUSE_QUOTA_S=600
# Détection des services systemd en échec (noms ignorés séparés par des virgules)
CONFIRM_SERVICE_S=60
SERVICES_IGNORES=
# Détection réseau
CONFIRM_RESEAU_S=60
RESEAU_INTERFACES=ens.*|eth.*|enp.*
SEUIL_PERTES_PAQUETS=5
SEUIL_RETRANS_TCP=5
SEUIL_PERTE_PING=20
SEUIL_LATENCE_MS=100
# Détection par les journaux (Loki)
LOKI_URL=http://10.10.0.10:3100
LOGS_FENETRE=2m
SEUIL_SSH_ECHECS=10
SEUIL_SUDO_ECHECS=3
